{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoryGuard game.json",
  "type": "object",
  "required": ["start", "items", "areas", "npcs", "quests", "events", "ending"],
  "additionalProperties": true,
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "idList": {"type": "array", "items": {"$ref": "#/definitions/id"}}
  },
  "properties": {
    "meta": {"type": "object"},
    "start": {
      "type": "object",
      "required": ["area"],
      "properties": {
        "area": {"$ref": "#/definitions/id"},
        "items": {"$ref": "#/definitions/idList"},
        "flags": {"$ref": "#/definitions/idList"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "connections"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"type": "string", "minLength": 1},
          "connections": {"$ref": "#/definitions/idList"},
          "requires_items": {"$ref": "#/definitions/idList"},
          "requires_flags": {"$ref": "#/definitions/idList"}
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "area"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"type": "string", "minLength": 1},
          "area": {"$ref": "#/definitions/id"},
          "dialogue": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "giver", "complete_area"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"type": "string", "minLength": 1},
          "giver": {"$ref": "#/definitions/id"},
          "requires_quests": {"$ref": "#/definitions/idList"},
          "complete_area": {"$ref": "#/definitions/id"},
          "requires_items": {"$ref": "#/definitions/idList"},
          "consumes_items": {"$ref": "#/definitions/idList"},
          "reward_items": {"$ref": "#/definitions/idList"},
          "reward_flags": {"$ref": "#/definitions/idList"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "area"],
        "properties": {
          "id": {"$ref": "#/definitions/id"},
          "name": {"type": "string", "minLength": 1},
          "area": {"$ref": "#/definitions/id"},
          "requires_items": {"$ref": "#/definitions/idList"},
          "requires_flags": {"$ref": "#/definitions/idList"},
          "requires_quests": {"$ref": "#/definitions/idList"},
          "gives_items": {"$ref": "#/definitions/idList"},
          "sets_flags": {"$ref": "#/definitions/idList"}
        }
      }
    },
    "ending": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "requires_items": {"$ref": "#/definitions/idList"},
        "requires_flags": {"$ref": "#/definitions/idList"}
      }
    }
  }
}
