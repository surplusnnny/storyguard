# 이 파일을 .env로 복사해서 값을 채운다. .env는 깃에 올리지 않는다.
# live: 실시간 호출 / mock: 서버 없이 모의 응답(연습용) / replay: 저장된 결과만 사용
# replay_first: 저장된 결과가 있으면 쓰고 없으면 실시간 호출(성공하면 저장). 평가 실험은 live로만 한다
LLM_MODE=mock
# vllm: GPU 서버(기본) / anthropic: Claude API. anthropic이면 ANTHROPIC_API_KEY와 LLM_MODELS=claude-haiku-5-5를 쓴다
LLM_PROVIDER=vllm
# Claude API 키(sk-ant-...). 서버 전용, 깃·채팅·화면 코드에 넣지 않는다
ANTHROPIC_API_KEY=
# 대회 GPU 서버의 vLLM 주소 (끝에 /v1 붙이지 않음)
LLM_BASE_URL=http://GPU서버주소:8000
LLM_API_KEY=EMPTY
# 쉼표로 여러 개. 앞의 모델이 실패하면 다음 모델로 넘어감
LLM_MODELS=
LLM_TIMEOUT=30
LLM_RETRY_WAITS=2,4
# 실시간 호출이 모두 실패하면 저장된 결과를 쓸지 (화면에 "저장된 결과"로 표시)
LLM_REPLAY_FALLBACK=1
# vLLM이 response_format(JSON 모드)을 지원하지 않으면 0
LLM_JSON_MODE=1
LLM_MAX_TOKENS=4096
# OpenAI(api.openai.com) 추론 모델의 생각 양: minimal / low / medium / high
LLM_REASONING_EFFORT=low

# 기록 저장소 (docs/DEPLOY-PLAN.md). 둘 다 있으면 Supabase에, 없으면 로컬 파일(data/)에 기록한다.
# SUPABASE_URL: Supabase 대시보드 → Project Settings → API의 Project URL
# SUPABASE_SECRET_KEY: Project Settings → API Keys의 secret 키(sb_secret_...). 서버 전용, 깃·채팅·화면 코드에 넣지 않는다
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT=2
